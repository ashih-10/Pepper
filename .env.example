# Copy this file to .env and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API (or "Connect" -> App Frameworks).
# The publishable key is safe to ship in the app; row-level security protects the data.
# NEVER put the Claude API key or the Supabase secret/service key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
